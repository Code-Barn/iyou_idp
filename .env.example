# Switch the entire IdP's identity between Tailscale and 127.0.0.1 in one line.
IYOU_BASE_URL=http://127.0.0.1:8000

# Django secret key (required in production)
IYOU_SECRET_KEY=your-secret-key-here

# Database URL (default: SQLite, use PostgreSQL in production)
# DATABASE_URL=postgres://user:password@host:5432/iyou_idp

# Redis URL (default: localhost:6379/1)
# REDIS_URL=redis://redis:6379/1

# Set to False in production
# DEBUG=True
