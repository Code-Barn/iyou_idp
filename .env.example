# Switch the entire IdP's identity between cluster DNS and localhost in one line.
IDP_BASE_URL=http://iyou-idp.identity.svc.cluster.local:8000

# Satellite application URLs (cluster-internal DNS)
IDP_WUN_URL=http://iyou-wun.satellite.svc.cluster.local:8001
IDP_HOME_URL=http://iyou-home.user.svc.cluster.local:9000
IDP_HOME_WS_URL=ws://iyou-home.user.svc.cluster.local:9001

# Django secret key (required in production)
IDP_SECRET_KEY=your-secret-key-here

# Comma-separated list of allowed hosts
IDP_ALLOWED_HOSTS=iyou-idp.identity.svc.cluster.local,iyou-idp,localhost

# Comma-separated list of CSRF trusted origins
IDP_CSRF_TRUSTED_ORIGINS=http://iyou-idp.identity.svc.cluster.local:8000

# Comma-separated list of CORS allowed origins
IDP_CORS_ALLOWED_ORIGINS=http://iyou-wun.satellite.svc.cluster.local:8001

# Database URL (default: SQLite, use PostgreSQL in production)
# DATABASE_URL=postgres://user:password@host:5432/iyou_idp

# Redis URL (default: cluster Redis headless service)
# REDIS_URL=redis://iyou-redis-master.identity.svc.cluster.local:6379/1

# Set to False in production
# IDP_DEBUG=True
