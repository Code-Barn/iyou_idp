# Switch the entire IdP's identity between Tailscale and 127.0.0.1 in one line.
IDP_BASE_URL=http://127.0.0.1:8000

# Django secret key (required in production)
IDP_SECRET_KEY=your-secret-key-here

# Comma-separated list of allowed hosts
IDP_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of CSRF trusted origins
IDP_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# Comma-separated list of CORS allowed origins
IDP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000

# Database URL (default: SQLite, use PostgreSQL in production)
# DATABASE_URL=postgres://user:password@host:5432/iyou_idp

# Redis URL (default: localhost:6379/1)
# REDIS_URL=redis://redis:6379/1

# Set to False in production
# IDP_DEBUG=True
