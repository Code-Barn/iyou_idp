# ──────────────────────────────────────────────────────────────────────────────
# iyou_idp — Autonomous Peer Node Environment
# Copy to `.env.peer`, edit every value, then:  docker compose -f docker-compose.peer.yml up -d
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ──────────────────────────────────────────────────────────────────────────────

# ── Customizable domain routing ───────────────────────────────────────────────
# Public HTTPS origin of this peer instance. Every OIDC endpoint, challenge URL,
# and passkey RP-ID derives from this single value.
IDP_BASE_URL=https://hub.community.org

# Tier-1 managed-identity did:web namespace. Managed users are minted here, so
# use YOUR OWN authority — never iyou.me. Scoped identifiers become
# did:web:hub.community.org:user:{uuid}.
IDP_WEB_DID_NAMESPACE=did:web:hub.community.org

# Django ALLOWED_HOSTS-equivalent: comma-separated hostnames this node answers to.
# (The task brief's "OIDC_ALLOWED_HOSTS" maps to IDP_ALLOWED_HOSTS.)
IDP_ALLOWED_HOSTS=hub.community.org

# Comma-separated origins allowed to POST CSRF-protected forms.
IDP_CSRF_TRUSTED_ORIGINS=https://hub.community.org

# Comma-separated origins allowed for CORS — add every satellite/rp origin here.
# (The task brief's "CORS_ALLOWED_ORIGINS" maps to IDP_CORS_ALLOWED_ORIGINS.)
IDP_CORS_ALLOWED_ORIGINS=https://hub.community.org,https://app.hub.community.org

# ── Django ────────────────────────────────────────────────────────────────────
# REQUIRED: strong random secret key (never reuse the dev fallback).
IDP_SECRET_KEY=<generate a strong random value>

# Must be False in production. When False: SECURE_PROXY_SSL_HEADER is honoured
# (X-Forwarded-Proto, so terminate TLS at the reverse proxy), and session/CSRF
# cookies are Secure-only.
IDP_DEBUG=False

# ── Satellites & companion endpoints ─────────────────────────────────────────
# Default post-login redirect target for YOUR satellite apps.
IDP_WUN_URL=https://app.hub.community.org

# Tier-3 desktop signing bridge (iyou_home). 9001 is the loopback WebSocket
# signing port. Point at your own gateway for full sovereignty.
IDP_HOME_URL=http://127.0.0.1:9000
IDP_HOME_WS_URL=wss://home.hub.community.org:9001/

# ── Data services ─────────────────────────────────────────────────────────────
# docker-compose.peer.yml builds DATABASE_URL / REDIS_URL from these values.
POSTGRES_DB=iyou_idp
POSTGRES_USER=iyou_idp
POSTGRES_PASSWORD=<generate a strong random value>

# ── Sovereign admin elevation ─────────────────────────────────────────────────
# did:key URI of the operator. Authenticating with this DID auto-elevates the
# matching user to staff+superuser via evaluate_sovereign_admin_posture().
ADMIN_DID=did:key:z6MknA51zaT8CpPx3qvAoqHDiXpSZnp4EqpQnw8FKbnbR5YV

# Emergency Tier-3 bypass uses challenge-nonce-only auth. Keep False on a peer.
ALLOW_EMERGENCY_BYPASS=False

# ── Optional Tier-1 managed OAuth providers (empty = provider disabled) ──────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=